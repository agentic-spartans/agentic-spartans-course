{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/openai/gpt-6-luna",
  "enabled_providers": ["openrouter"],
  "default_agent": "orchestrator",
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true },
    "general": { "disable": true },
    "explore": { "disable": true }
  },
  "provider": {
    "openrouter": {
      "whitelist": ["openai/gpt-6-luna"],
      "models": {
        "openai/gpt-6-luna": {
          "options": {
            "provider": {
              "order": ["openai", "azure"],
              "allow_fallbacks": false
            },
            "reasoning": { "effort": "high" }
          }
        }
      }
    }
  },
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "edit": {
      "*": "deny",
      "runs/*/logs/log.md": "allow",
      "runs/*/deliverable/*": "deny",
      "runs/*/work/*": "deny"
    },
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "curl *": "allow",
      "wget *": "allow",
      "ssh *": "ask",
      "scp *": "ask",
      "git *": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "open *": "ask",
      "osascript *": "ask"
    },
    "websearch": "deny",
    "external_directory": { "*": "ask", "~/.local/share/opencode/tool-output/*": "allow" },
    "skill": "deny",
    "execute": "deny",
    "question": "deny",
    "doom_loop": "ask"
  }
}
