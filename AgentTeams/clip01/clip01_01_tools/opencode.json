{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/openai/gpt-6-luna",
  "enabled_providers": ["openrouter"],
  "default_agent": "agent",
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true },
    "general": { "disable": true },
    "explore": { "disable": true }
  },
  "provider": {
    "openrouter": {
      "whitelist": ["openai/gpt-6-luna"],
      "models": {
        "openai/gpt-6-luna": {
          "options": {
            "provider": { "order": ["openai", "azure"], "allow_fallbacks": false },
            "reasoning": { "effort": "high" }
          }
        }
      }
    }
  },
  "permission": {
    "*": "allow",
    "edit": "deny",
    "external_directory": { "*": "deny", "~/.local/share/opencode/tool-output/*": "allow" },
    "skill": "deny",
    "execute": "deny",
    "bash": { "sudo *": "deny", "curl *": "deny", "wget *": "deny", "rm *": "deny", "Remove-Item *": "deny", "ri *": "deny", "del *": "deny", "erase *": "deny", "rd *": "deny", "cmd /c *": "deny", "powershell *": "deny", "pwsh *": "deny" }
  }
}
