{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/openai/gpt-6-luna",
  "enabled_providers": ["openrouter"],
  "websearch": { "provider": "exa" },
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true },
    "general": { "disable": true },
    "explore": { "disable": true }
  },
  "provider": {
    "openrouter": {
      "whitelist": ["openai/gpt-6-luna"],
      "models": {
        "openai/gpt-6-luna": {
          "options": {
            "provider": {
              "order": ["openai", "azure"],
              "allow_fallbacks": false
            },
            "reasoning": { "effort": "high" }
          }
        }
      }
    }
  },
  "permission": {
    "*": "allow",
    "read": {
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "bash": {
      "sudo *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "git *": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "open *": "ask",
      "osascript *": "ask",
      "rm *": "ask",
      "/bin/rm *": "ask",
      "command rm *": "ask",
      "*=* rm *": "ask",
      "unlink *": "ask",
      "rmdir *": "ask",
      "find * -delete*": "ask",
      "find * -exec rm *": "ask",
      "xargs rm*": "ask",
      "sh -c *": "ask",
      "bash -c *": "ask",
      "zsh -c *": "ask",
      "Remove-Item *": "ask",
      "ri *": "ask",
      "del *": "ask",
      "erase *": "ask",
      "rd *": "ask",
      "cmd /c *": "ask",
      "powershell *": "ask",
      "pwsh *": "ask"
    },
    "external_directory": { "*": "ask", "~/.local/share/opencode/tool-output/*": "allow" },
    "skill": "deny",
    "task": "deny",
    "execute": "deny",
    "question": "deny",
    "doom_loop": "ask"
  }
}
